# Copy to .env and fill in real values: cp .env.example .env

# App
PORT=3000
JWT_SECRET=change-me

# Database (DB_HOST=localhost for local dev; docker compose overrides it to "mysql")
DB_HOST=localhost
DB_PORT=3306
DB_NAME=expense_tracker
DB_USER=change-me
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
